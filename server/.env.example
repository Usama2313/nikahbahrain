# Supabase Database Configuration
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
# Optional: for admin operations needing elevated permissions
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ─── Instagram Session Cookie (REQUIRED for accurate profile data) ────────────
# The new API-based Instagram fetcher needs your session cookie to get full
# post captions. Without it, only ~12 public posts load without caption text.
#
# HOW TO GET YOUR SESSION ID (takes 2 minutes):
#   1. Open Chrome and go to https://www.instagram.com
#   2. Log in to the @nikah_bahrain Instagram account (or any account)
#   3. Press F12 to open DevTools
#   4. Click "Application" tab → "Cookies" → "https://www.instagram.com"
#   5. Find and copy these three values:
#
INSTAGRAM_SESSION_ID=your_sessionid_cookie_value_here
INSTAGRAM_CSRF=your_csrftoken_cookie_value_here
INSTAGRAM_DID=your_ig_did_cookie_value_here

# Optional: Override Chrome path if not in default location
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Server Port
PORT=5000
