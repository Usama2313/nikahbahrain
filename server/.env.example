# Supabase Database Configuration
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
# Optional: for admin operations needing elevated permissions
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Instagram Scraper Session (for authenticated access to see ALL posts)
# Without this, the scraper can only see ~12 posts visible without login.
# To get these values:
#   1. Log in to Instagram in Chrome
#   2. Open DevTools → Application → Cookies → instagram.com
#   3. Copy the value of: sessionid, ig_did, csrftoken
INSTAGRAM_SESSION_ID=your_instagram_sessionid_cookie_value
INSTAGRAM_DID=your_instagram_ig_did_cookie_value
INSTAGRAM_CSRF=your_instagram_csrftoken_cookie_value

# Optional: Override Chrome path if not in default location
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Server Port
PORT=5000
